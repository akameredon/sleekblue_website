# ─────────────────────────────────────────────────────────────────────────────
# Sleekblue Media Houz — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file to .env in the same directory:
#        cp .env.example .env
#   2. Fill in every value marked REQUIRED before deploying.
#   3. NEVER commit your real .env to version control — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────


# ── Server ────────────────────────────────────────────────────────────────────

# Port the Express server listens on.
# Hostinger assigns this automatically — leave blank and it defaults to 3000.
PORT=

# Runtime environment. Must be "production" on any live server.
# The server will refuse to start with missing secrets unless this is set.
NODE_ENV=production


# ── Authentication (REQUIRED in production) ───────────────────────────────────

# Long random string used to sign admin JWT tokens.
# MINIMUM 32 characters. The server will reject shorter values.
# Generate a secure value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin dashboard login credentials.
# ADMIN_USERNAME defaults to "admin" if not set — change it for extra security.
ADMIN_USERNAME=admin

# REQUIRED: A strong password for the admin dashboard.
# Use a passphrase or random string — avoid simple dictionary words.
ADMIN_PASSWORD=


# ── Payments (REQUIRED in production) ────────────────────────────────────────

# Your Paystack secret key. Found in Paystack Dashboard → Settings → API Keys.
# Use the LIVE key for production, TEST key for development.
# The server will refuse to start in production if this is missing.
PAYSTACK_SECRET_KEY=
